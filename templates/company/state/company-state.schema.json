{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "company-state.schema.json",
  "title": "Bootstrap OS company-state",
  "description": "Minimum durable cursor for a company instance. Blank template only — do not fill with another founder’s market. Additional properties are allowed.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "version",
    "companyId",
    "journeyPhase",
    "loopStage",
    "gateStatus",
    "autonomyPosture",
    "readyForHumanEyes",
    "openQuestions"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Instance state schema version, not the OS blueprint version."
    },
    "companyId": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis": {
      "type": "string",
      "description": "One sentence. Subject to evidence — not gospel."
    },
    "journeyPhase": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9,
      "description": "Stored journey integer 1–9 (slow clock). Spoken maps to five rungs. Founder-gated. No invented Advance."
    },
    "loopStage": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7,
      "description": "Stored loop integer 1–7 (back-compat). Ask / Do / Write back is a quality bar, not a card. Mutations are rejected."
    },
    "gateStatus": {
      "type": "string",
      "enum": ["open", "waiting", "blocked"]
    },
    "autonomyPosture": {
      "type": "string",
      "enum": ["strict", "auto", "dangerous"]
    },
    "readyForHumanEyes": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["unknown", "blocked", "green"]
        },
        "checkedAt": {
          "type": ["string", "null"]
        },
        "happyPath": {
          "type": "string"
        },
        "evidencePath": {
          "type": ["string", "null"],
          "description": "Optional path to product/READY_FOR_HUMAN_EYES.md or a report."
        },
        "blockers": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "problemEvidence": { "type": ["number", "null"] },
        "willingnessToPay": { "type": ["number", "null"] },
        "completion": { "type": ["number", "null"] },
        "traceCompleteness": { "type": ["number", "null"] },
        "notes": { "type": "string" }
      }
    },
    "founderApprovals": {
      "type": "array"
    },
    "openQuestions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "lastAction": {
      "type": "string"
    },
    "lastWeeklySnapshotAt": {
      "type": ["string", "null"],
      "description": "Date of last control-plane snapshot (YYYY-MM-DD or timestamp)."
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "supporting": {
      "type": "array",
      "description": "Same company snapshot. No rungs. Cannot promote. Exile rejected.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["role", "state", "nextAction", "lastObservedFact"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["advisor", "investor", "counsel", "contractor", "partner"]
          },
          "state": {
            "type": "string",
            "enum": ["promise", "clock", "done", "dead"]
          },
          "clock": {
            "type": "string",
            "description": "Clock date, or — when none."
          },
          "nextAction": { "type": "string" },
          "lastObservedFact": { "type": "string" }
        }
      }
    },
    "engagements": {
      "type": "array",
      "description": "Named accounts under the primary. NDA is not Try. No journeyPhase.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["account", "kind", "state"],
        "properties": {
          "account": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["nda", "quote", "pilot-sow", "plant-run"]
          },
          "state": {
            "type": "string",
            "enum": ["promise", "clock", "done", "dead"]
          }
        }
      }
    },
    "initiatives": {
      "type": "array",
      "description": "OS 2.8.19 report card rows. New writes. Dual-read supporting / engagements / constraintThisWeek when empty. No journeyPhase.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "premise",
          "measure",
          "killLine",
          "status",
          "last",
          "next",
          "outcome",
          "impact",
          "evidence"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": ["customer_check", "engagement", "capital", "legal", "advisor"]
          },
          "premise": { "type": "string" },
          "measure": { "type": "string" },
          "killLine": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["proposed", "active", "waiting", "closed"]
          },
          "last": { "type": "string" },
          "next": { "type": "string" },
          "outcome": {
            "type": "string",
            "enum": ["none", "learned", "delivered", "killed"]
          },
          "impact": {
            "type": "string",
            "enum": ["none", "learning", "revenue", "obligation", "clock"]
          },
          "evidence": {
            "type": "string",
            "enum": ["stated", "synthetic", "observed"]
          },
          "clock": { "type": "string" },
          "parentId": { "type": "string" }
        }
      }
    }
  }
}
