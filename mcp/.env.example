# Optional later (env pin is parked). Public OS tools work without these.
# CI and PR agents use PGlite — do not point tests at the live project.
# Never put the service role here. Never commit real keys.

BOOTSTRAP_SUPABASE_URL=
BOOTSTRAP_SUPABASE_ANON_KEY=
# PostgREST HS256 secret. Empty or unset: a bound at+jwt is HTTP 401 (no mint, not forwarded).
BOOTSTRAP_SUPABASE_JWT_SECRET=
